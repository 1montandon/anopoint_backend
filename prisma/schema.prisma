// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DiaSemana {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

enum OrigemPedido {
  SITE
  WHATSAPP
  BALCAO
}

enum TipoPedido {
  DELIVERY
  RETIRADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CREDITO
  DEBITO
}

enum StatusPedido {
  RECEBIDO
  EM_PREPARO
  PRONTO
  SAIU_PARA_ENTREGA
  FINALIZADO
  CANCELADO
}

enum StatusPagamento {
  PENDENTE
  PAGO
}

model Lanchonete {
  id              Int      @id @default(autoincrement())
  nome            String   @db.VarChar(120)
  slug            String   @unique @db.VarChar(100)
  logoUrl         String?  @map("logo_url") @db.VarChar(500)
  telefone        String   @db.VarChar(20)
  ativo           Boolean  @default(true)
  aceitaDelivery  Boolean  @default(true) @map("aceita_delivery")
  aceitaRetirada  Boolean  @default(true) @map("aceita_retirada")
  pedidoMinimo    Decimal  @default(0) @map("pedido_minimo") @db.Decimal(10, 2)
  fusoHorario     String   @map("fuso_horario") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  usuarios      Usuario[]
  horarios      HorarioFuncionamento[]
  taxasEntrega  TaxaEntrega[]
  clientes      Cliente[]
  categorias    Categoria[]
  adicionais    Adicional[]
  pedidos       Pedido[]

  @@map("lanchonete")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  lanchoneteId  Int      @map("lanchonete_id")
  nome          String   @db.VarChar(120)
  email         String   @unique @db.VarChar(255)
  senhaHash     String   @map("senha_hash") @db.VarChar(255)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchoneteId], references: [id], onDelete: Restrict)

  @@index([lanchoneteId])
  @@map("usuario")
}

model HorarioFuncionamento {
  id           Int       @id @default(autoincrement())
  lanchoneteId Int       @map("lanchonete_id")
  diaSemana    DiaSemana @map("dia_semana")
  horaAbertura DateTime? @map("hora_abertura") @db.Time(0)
  horaFechamento DateTime? @map("hora_fechamento") @db.Time(0)
  fechado      Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchoneteId], references: [id], onDelete: Restrict)

  @@index([lanchoneteId, diaSemana])
  @@map("horario_funcionamento")
}

model TaxaEntrega {
  id           Int      @id @default(autoincrement())
  lanchoneteId Int      @map("lanchonete_id")
  bairro       String   @db.VarChar(120)
  valor        Decimal  @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchoneteId], references: [id], onDelete: Restrict)

  enderecos Endereco[]

  @@unique([lanchoneteId, bairro])
  @@index([lanchoneteId])
  @@map("taxa_entrega")
}

model Cliente {
  id           Int      @id @default(autoincrement())
  lanchoneteId Int      @map("lanchonete_id")
  nome         String   @db.VarChar(120)
  telefone     String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchoneteId], references: [id], onDelete: Restrict)

  enderecos Endereco[]
  pedidos   Pedido[]

  @@unique([lanchoneteId, telefone])
  @@index([lanchoneteId])
  @@map("cliente")
}

model Endereco {
  id            Int      @id @default(autoincrement())
  clienteId     Int      @map("cliente_id")
  taxaEntregaId Int?     @map("taxa_entrega_id")
  rua           String   @db.VarChar(150)
  bairro        String   @db.VarChar(120)
  cidade        String   @db.VarChar(120)
  numero        String   @db.VarChar(20)
  complemento   String?  @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cliente Cliente @relation( fields: [clienteId], references: [id], onDelete: Restrict)

  taxaEntrega TaxaEntrega? @relation( fields: [taxaEntregaId], references: [id], onDelete: SetNull)

  pedidos Pedido[]

  @@index([clienteId])
  @@index([taxaEntregaId])
  @@map("endereco")
}

model Categoria {
  id           Int      @id @default(autoincrement())
  lanchoneteId Int      @map("lanchonete_id")
  nome         String   @db.VarChar(120)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lanchonete Lanchonete @relation( fields: [lanchoneteId], references: [id], onDelete: Restrict)

  produtos Produto[]

  @@unique([lanchoneteId, nome])
  @@index([lanchoneteId])
  @@map("categoria")
}

model Produto {
  id          Int      @id @default(autoincrement())
  categoriaId Int      @map("categoria_id")
  nome        String   @db.VarChar(150)
  preco       Decimal  @db.Decimal(10, 2)
  descricao   String?
  fotoUrl     String?  @map("foto_url") @db.VarChar(500)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categoria Categoria @relation( fields: [categoriaId], references: [id], onDelete: Restrict)


  promocoes        Promocao[]
  adicionais       ProdutoAdicional[]
  itensPedido      ItemPedido[]

  @@index([categoriaId])
  @@index([ativo])
  @@map("produto")
}

model Adicional {
  id           Int      @id @default(autoincrement())
  lanchoneteId Int      @map("lanchonete_id")
  nome         String   @db.VarChar(120)
  preco        Decimal  @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchoneteId], references: [id], onDelete: Restrict)

  produtos     ProdutoAdicional[]
  itensPedido  ItemPedidoAdicional[]

  @@unique([lanchoneteId, nome])
  @@index([lanchoneteId])
  @@map("adicional")
}

model ProdutoAdicional {
  produtoId   Int      @map("produto_id")
  adicionalId Int      @map("adicional_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  adicional Adicional @relation( fields: [adicionalId], references: [id], onDelete: Cascade)

  @@id([produtoId, adicionalId])
  @@index([adicionalId])
  @@map("produto_adicional")
}

model Promocao {
  id               Int       @id @default(autoincrement())
  produtoId        Int       @map("produto_id")
  diaSemana        DiaSemana @map("dia_semana")
  precoPromocional Decimal   @map("preco_promocional") @db.Decimal(10, 2)
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  produto Produto @relation( fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([produtoId, diaSemana])
  @@index([produtoId])
  @@map("promocao")
}

model Pedido {
  id               Int               @id @default(autoincrement())
  lanchoneteId     Int               @map("lanchonete_id")
  clienteId        Int?              @map("cliente_id")
  enderecoId       Int?              @map("endereco_id")

  origem           OrigemPedido
  tipo             TipoPedido
  formaPagamento   FormaPagamento    @map("forma_pagamento")
  statusPedido     StatusPedido      @default(RECEBIDO) @map("status_pedido")
  statusPagamento  StatusPagamento   @default(PENDENTE) @map("status_pagamento")

  // Snapshot do cliente
  clienteNome      String            @map("cliente_nome") @db.VarChar(120)
  clienteTelefone  String            @map("cliente_telefone") @db.VarChar(20)

  // Snapshot do endereço.
  // Nullable porque pedidos RETIRADA não possuem endereço.
  enderecoRua         String? @map("endereco_rua") @db.VarChar(150)
  enderecoBairro      String? @map("endereco_bairro") @db.VarChar(120)
  enderecoCidade      String? @map("endereco_cidade") @db.VarChar(120)
  enderecoNumero      String? @map("endereco_numero") @db.VarChar(20)
  enderecoComplemento String? @map("endereco_complemento") @db.VarChar(150)

  subtotal         Decimal  @db.Decimal(10, 2)
  taxaEntrega      Decimal  @default(0) @map("taxa_entrega") @db.Decimal(10, 2)
  total            Decimal  @db.Decimal(10, 2)
  observacao       String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lanchonete Lanchonete @relation(fields: [lanchoneteId], references: [id], onDelete: Restrict)

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  endereco Endereco? @relation( fields: [enderecoId], references: [id], onDelete: SetNull)

  itens ItemPedido[]

  @@index([lanchoneteId])
  @@index([clienteId])
  @@index([enderecoId])
  @@index([lanchoneteId, statusPedido])
  @@index([lanchoneteId, createdAt])
  @@map("pedido")
}

model ItemPedido {
  id            Int      @id @default(autoincrement())
  pedidoId      Int      @map("pedido_id")
  produtoId     Int?     @map("produto_id")

  // Snapshot do produto
  produtoNome   String   @map("produto_nome") @db.VarChar(150)
  quantidade    Int
  precoOriginal Decimal  @map("preco_original") @db.Decimal(10, 2)
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  observacao    String?

  pedido Pedido @relation(fields: [pedidoId], references: [id],onDelete: Restrict)

  produto Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)

  adicionais ItemPedidoAdicional[]

  @@index([pedidoId])
  @@index([produtoId])
  @@map("item_pedido")
}

model ItemPedidoAdicional {
  id           Int     @id @default(autoincrement())
  itemPedidoId Int     @map("item_pedido_id")
  adicionalId  Int?    @map("adicional_id")

  // Snapshot do adicional
  nome         String  @db.VarChar(120)
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)
  quantidade    Int

  itemPedido ItemPedido @relation(fields: [itemPedidoId], references: [id], onDelete: Restrict)

  adicional Adicional? @relation( fields: [adicionalId], references: [id], onDelete: SetNull)

  @@index([itemPedidoId])
  @@index([adicionalId])
  @@map("item_pedido_adicional")
}
