generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OrderSource {
  WEBSITE
  WHATSAPP
  COUNTER
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

model Restaurant {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(120)
  slug            String   @unique @db.VarChar(100)
  logoUrl         String?  @map("logo_url") @db.VarChar(500)
  phone           String   @db.VarChar(20)
  active          Boolean  @default(true)
  acceptsDelivery Boolean  @default(true) @map("accepts_delivery")
  acceptsPickup   Boolean  @default(true) @map("accepts_pickup")
  minimumOrder    Decimal  @default(0) @map("minimum_order") @db.Decimal(10, 2)
  timeZone        String   @map("time_zone") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users         User[]
  businessHours BusinessHour[]
  deliveryFees  DeliveryFee[]
  customers     Customer[]
  categories    Category[]
  addOns        AddOn[]
  orders        Order[]

  @@map("restaurant")
}

model User {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([restaurantId])
  @@map("user")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  userAgent String?  @map("user_agent") @db.Text
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

model BusinessHour {
  id           Int       @id @default(autoincrement())
  restaurantId Int       @map("restaurant_id")
  weekday      Weekday
  openingTime  DateTime? @map("opening_time") @db.Time(0)
  closingTime  DateTime? @map("closing_time") @db.Time(0)
  closed       Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId, weekday])
  @@map("business_hour")
}

model DeliveryFee {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  neighborhood String   @db.VarChar(120)
  amount       Decimal  @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  addresses  Address[]

  @@unique([restaurantId, neighborhood])
  @@index([restaurantId])
  @@map("delivery_fee")
}

model Customer {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  name         String   @db.VarChar(120)
  phone        String   @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  addresses  Address[]
  orders     Order[]

  @@unique([restaurantId, phone])
  @@index([restaurantId])
  @@map("customer")
}

model Address {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  deliveryFeeId Int?     @map("delivery_fee_id")
  street        String   @db.VarChar(150)
  neighborhood  String   @db.VarChar(120)
  city          String   @db.VarChar(120)
  number        String   @db.VarChar(20)
  complement    String?  @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryFee DeliveryFee? @relation(fields: [deliveryFeeId], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([customerId])
  @@index([deliveryFeeId])
  @@map("address")
}

model Category {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  name         String   @db.VarChar(120)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   Product[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("category")
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  name        String   @db.VarChar(150)
  price       Decimal  @db.Decimal(10, 2)
  description String?
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  promotions Promotion[]
  addOns     ProductAddOn[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([active])
  @@map("product")
}

model AddOn {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  name         String   @db.VarChar(120)
  price        Decimal  @db.Decimal(10, 2)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  products   ProductAddOn[]
  orderItems OrderItemAddOn[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@map("add_on")
}

model ProductAddOn {
  productId Int      @map("product_id")
  addOnId   Int      @map("add_on_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  addOn   AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([productId, addOnId])
  @@index([addOnId])
  @@map("product_add_on")
}

model Promotion {
  id               Int      @id @default(autoincrement())
  productId        Int      @map("product_id")
  weekday          Weekday
  promotionalPrice Decimal  @map("promotional_price") @db.Decimal(10, 2)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, weekday])
  @@index([productId])
  @@map("promotion")
}

model Order {
  id            Int           @id @default(autoincrement())
  restaurantId  Int           @map("restaurant_id")
  customerId    Int?          @map("customer_id")
  addressId     Int?          @map("address_id")
  source        OrderSource
  type          OrderType
  paymentMethod PaymentMethod @map("payment_method")
  orderStatus   OrderStatus   @default(RECEIVED) @map("order_status")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  // Customer snapshot
  customerName  String @map("customer_name") @db.VarChar(120)
  customerPhone String @map("customer_phone") @db.VarChar(20)

  // Address snapshot. Nullable because pickup orders do not have an address.
  addressStreet       String? @map("address_street") @db.VarChar(150)
  addressNeighborhood String? @map("address_neighborhood") @db.VarChar(120)
  addressCity         String? @map("address_city") @db.VarChar(120)
  addressNumber       String? @map("address_number") @db.VarChar(20)
  addressComplement   String? @map("address_complement") @db.VarChar(150)

  subtotal    Decimal  @db.Decimal(10, 2)
  deliveryFee Decimal  @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  address    Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items      OrderItem[]

  @@index([restaurantId])
  @@index([customerId])
  @@index([addressId])
  @@index([restaurantId, orderStatus])
  @@index([restaurantId, createdAt])
  @@map("order")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int     @map("order_id")
  productId     Int?    @map("product_id")
  productName   String  @map("product_name") @db.VarChar(150)
  quantity      Int
  originalPrice Decimal @map("original_price") @db.Decimal(10, 2)
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  notes         String?

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  addOns  OrderItemAddOn[]

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

model OrderItemAddOn {
  id          Int     @id @default(autoincrement())
  orderItemId Int     @map("order_item_id")
  addOnId     Int?    @map("add_on_id")
  name        String  @db.VarChar(120)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity    Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  addOn     AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([addOnId])
  @@map("order_item_add_on")
}

